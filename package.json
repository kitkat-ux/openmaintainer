{
  "name": "openmaintainer",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source AI maintainer for GitHub repositories.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev": "corepack pnpm --filter @openmaintainer/github-app dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "demo": "corepack pnpm build && node packages/cli/dist/index.js demo",
    "validate": "corepack pnpm build && node packages/cli/dist/index.js validate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "clean": "find . -type d -name dist -prune -exec rm -rf {} +",
    "cli": "node packages/cli/dist/index.js",
    "demo:run": "node packages/cli/dist/index.js demo",
    "verify": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm demo:run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.6.1"
  },
  "type": "module"
}
